<Window
    x:Class="DiskOfflineToolWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="磁盘脱机工具">

  <!-- 根布局：标题区 + 命令栏 + 磁盘列表 + 状态栏 -->
  <Grid RowSpacing="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 标题区 -->
    <StackPanel Grid.Row="0" Margin="24,20,24,8" Spacing="2">
      <TextBlock Text="磁盘脱机工具" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock x:Name="SubtitleText"
                 Text="选择一块磁盘，执行脱机 / 联机 / 弹出 · 分离"
                 Style="{StaticResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>

    <!-- 未提权提示 -->
    <InfoBar x:Name="ElevationBar"
             Grid.Row="1"
             Margin="24,0,24,8"
             Severity="Warning"
             IsOpen="False"
             IsClosable="False"
             Title="需要管理员权限"
             Message="当前未提权，只能查看，无法执行脱机/联机/弹出等操作。">
      <InfoBar.ActionButton>
        <Button Content="以管理员身份重新启动" Click="OnRestartElevatedClick" />
      </InfoBar.ActionButton>
    </InfoBar>

    <!-- 命令栏 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="24,0,24,12" Spacing="8">
      <Button x:Name="RefreshButton" Click="OnRefreshClick">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE72C;" FontSize="14" />
          <TextBlock Text="刷新" />
        </StackPanel>
      </Button>
      <AppBarSeparator />
      <Button x:Name="OfflineButton" Click="OnOfflineClick" IsEnabled="False">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE7B3;" FontSize="14" />
          <TextBlock Text="脱机" />
        </StackPanel>
      </Button>
      <Button x:Name="OnlineButton" Click="OnOnlineClick" IsEnabled="False">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE768;" FontSize="14" />
          <TextBlock Text="联机" />
        </StackPanel>
      </Button>
      <Button x:Name="RemoveButton" Click="OnRemoveClick" IsEnabled="False" Style="{StaticResource AccentButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE8AB;" FontSize="14" />
          <TextBlock x:Name="RemoveButtonText" Text="弹出" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- 选中项信息：独立一行，窗口变窄时自动换行（原来挤在按钮后面会被截断） -->
    <Border Grid.Row="3"
            Margin="24,0,24,12"
            Padding="12,8"
            CornerRadius="6"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
      <TextBlock x:Name="SelectionText"
                 Text="未选择磁盘"
                 TextWrapping="Wrap"
                 Style="{StaticResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Border>

    <!--
      列表：表头放进 ListView.Header，这样表头与数据行共用同一个滚动容器，
      窗口变窄时会出现横向滚动条，两者一起左右滑动（原来表头是独立区域，无法同步滚动）。
      行内容设置 MinWidth，保证窗口过窄时不是"压缩内容"而是"出现滚动条"。
    -->
    <Border Grid.Row="4"
            Margin="24,0,24,12"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            CornerRadius="6">
      <ListView x:Name="DiskList"
                SelectionMode="Single"
                SelectionChanged="OnSelectionChanged"
                DoubleTapped="OnListDoubleTapped"
                Padding="0"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.IsHorizontalRailEnabled="True">
        <ListView.Header>
          <Grid MinWidth="880"
                Padding="12,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="300" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" MinWidth="60" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="磁盘" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="设备名称" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="总线" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="容量" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="分区" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="5" Text="状态" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="6" Text="分区表" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
          </Grid>
        </ListView.Header>
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid MinWidth="880" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" MinWidth="60" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding NumberText}" />
              <TextBlock Grid.Column="1" Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding BusTypeName}" />
              <TextBlock Grid.Column="3" Text="{Binding CapacityText}" />
              <TextBlock Grid.Column="4" Text="{Binding Partitions.Count}" />
              <TextBlock Grid.Column="5" Text="{Binding StatusText}" />
              <TextBlock Grid.Column="6" Text="{Binding StyleText}" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

    <!-- 状态栏 -->
    <Border Grid.Row="5" Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Padding="24,8">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="就绪" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="PermissionText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
