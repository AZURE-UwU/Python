<Window x:Class="DiskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiskManager.Controls"
        Title="磁盘管理器（旧版 WPF · 已停止更新）"
        Height="760"
        Width="1180"
        MinHeight="420"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
  <DockPanel>

    <!-- 菜单栏 -->
    <Menu DockPanel.Dock="Top" Padding="2">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="刷新(_R)" InputGestureText="F5" Click="OnRefreshClick" />
        <Separator />
        <MenuItem Header="退出(_X)" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="操作(_A)">
        <MenuItem x:Name="AllVolumeTasksMenu" Header="所有卷任务" />
        <MenuItem x:Name="AllDiskTasksMenu" Header="所有磁盘任务" />
      </MenuItem>
      <MenuItem Header="查看(_V)">
        <MenuItem x:Name="ViewTopMenu" Header="顶部(_T)" IsCheckable="True" IsChecked="True" Click="OnToggleTopClick" />
        <MenuItem x:Name="ViewBottomMenu" Header="底部(_B)" IsCheckable="True" IsChecked="True" Click="OnToggleBottomClick" />
        <Separator />
        <MenuItem Header="刷新(_R)" InputGestureText="F5" Click="OnRefreshClick" />
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="关于磁盘管理器(_A)" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <!-- 状态栏 -->
    <StatusBar DockPanel.Dock="Bottom" Background="#F5F6F8" BorderBrush="#D5DAE0" BorderThickness="0,1,0,0">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="就绪" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="ConnectionText" Text="" />
      </StatusBarItem>
    </StatusBar>

    <!-- 未提权提示条 -->
    <Border x:Name="ElevationBanner"
            DockPanel.Dock="Top"
            Background="#FFF4CE"
            BorderBrush="#E0C97F"
            BorderThickness="0,0,0,1"
            Padding="10,6"
            Visibility="Collapsed">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="以管理员身份重新启动" Padding="10,2" Click="OnRestartElevatedClick" />
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="当前未以管理员身份运行：只能查看，无法执行脱机/联机、初始化、新建卷等操作。" />
      </DockPanel>
    </Border>

    <!-- 上下两个窗格 -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="TopRow" Height="*" MinHeight="120" />
        <RowDefinition Height="Auto" />
        <RowDefinition x:Name="BottomRow" Height="*" MinHeight="120" />
      </Grid.RowDefinitions>

      <!-- 上：卷列表 -->
      <DataGrid x:Name="VolumeGrid"
                Grid.Row="0"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="None"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                RowHeight="24"
                Background="White"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                CanUserReorderColumns="False"
                CanUserSortColumns="False"
                EnableRowVirtualization="False"
                SelectionChanged="OnVolumeSelectionChanged"
                ContextMenuOpening="OnVolumeGridContextMenuOpening"
                MouseRightButtonDown="OnVolumeGridRightButtonDown">
        <DataGrid.Columns>
          <DataGridTextColumn Header="卷" Binding="{Binding DisplayName}" Width="215" />
          <DataGridTextColumn Header="布局" Binding="{Binding LayoutText}" Width="70" />
          <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" Width="110" />
          <DataGridTextColumn Header="文件系统" Binding="{Binding FileSystemText}" Width="80" />
          <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="85" />
          <DataGridTextColumn Header="容量" Binding="{Binding CapacityText}" Width="90" />
          <DataGridTextColumn Header="可用空间" Binding="{Binding FreeSpaceText}" Width="90" />
          <DataGridTextColumn Header="% 可用" Binding="{Binding FreePercentText}" Width="65" />
          <DataGridTextColumn Header="容错" Binding="{Binding FaultToleranceText}" Width="55" />
          <DataGridTextColumn Header="开销" Binding="{Binding OverheadText}" Width="55" />
          <DataGridTextColumn Header="磁盘" Binding="{Binding DiskText}" Width="*" MinWidth="110" />
        </DataGrid.Columns>
      </DataGrid>

      <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="#E4E7EB" />

      <!-- 下：磁盘图 -->
      <Border Grid.Row="2" BorderBrush="#D5DAE0" BorderThickness="0,1,0,0" Background="White">
        <controls:DiskMapView x:Name="DiskMap" />
      </Border>
    </Grid>
  </DockPanel>
</Window>
