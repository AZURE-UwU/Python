<Project Sdk="Microsoft.NET.Sdk">

  <!--
    磁盘管理器（Disk Manager）· WPF 版【已冻结】
    ==================================================================
    ⚠ 版本状态：本工程已停止更新，仅保留可用（不再加功能、不再改交互）。
       主线开发在 ../DiskManagerWinUI（WinUI 3 版），两版共用同一份磁盘逻辑
       （Interop / Models / Services 源码链接），行为一致。
       保留它的原因：WinUI 版依赖 Windows App Runtime，WPF 版没有任何额外依赖，
       在没装运行时的机器上仍可直接运行。
    ==================================================================
    版本记录：
      v0.1  2026-09-16  初始工程骨架：WPF + 原生磁盘 IOCTL + Storage WMI

    说明：
      1) 默认使用 app.manifest（requireAdministrator），双击即请求管理员权限；
         「脱机 / 联机 / 初始化 / 新建卷」等写操作缺管理员权限无法调用系统接口。
      2) 调试期若需要以普通权限启动（例如只验证界面），可执行：
             dotnet build -p:NoAdmin=true
         该开关会改用 app.invoker.manifest，界面照常显示，写操作会提示权限不足。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DiskManager</AssemblyName>
    <RootNamespace>DiskManager</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest Condition="'$(NoAdmin)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(NoAdmin)' == 'true'">app.invoker.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Company>Bowen</Company>
    <Product>磁盘管理器</Product>
    <AssemblyTitle>磁盘管理器</AssemblyTitle>
    <FileVersion>1.0.0.0</FileVersion>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
