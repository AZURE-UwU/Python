<Window
    x:Class="DiskManagerWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DiskManagerWinUI.Controls"
    Title="磁盘管理器">

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 菜单栏 -->
    <MenuBar Grid.Row="0">
      <MenuBarItem Title="文件(_F)">
        <MenuFlyoutItem Text="刷新" Click="OnRefreshClick">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" />
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="退出" Click="OnExitClick" />
      </MenuBarItem>

      <MenuBarItem Title="操作(_A)">
        <MenuFlyoutSubItem x:Name="AllVolumeTasksMenu" Text="所有卷任务">
          <MenuFlyoutItem Text="（请先选择卷）" IsEnabled="False" />
        </MenuFlyoutSubItem>
        <MenuFlyoutSubItem x:Name="AllDiskTasksMenu" Text="所有磁盘任务">
          <MenuFlyoutItem Text="（请先选择磁盘）" IsEnabled="False" />
        </MenuFlyoutSubItem>
      </MenuBarItem>

      <MenuBarItem Title="查看(_V)">
        <ToggleMenuFlyoutItem x:Name="ViewTopToggle" Text="顶部（卷列表）" IsChecked="True" Click="OnViewToggleClick" />
        <ToggleMenuFlyoutItem x:Name="ViewBottomToggle" Text="底部（磁盘图）" IsChecked="True" Click="OnViewToggleClick" />
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="刷新" Click="OnRefreshClick" />
      </MenuBarItem>

      <MenuBarItem Title="帮助(_H)">
        <MenuFlyoutItem Text="关于磁盘管理器" Click="OnAboutClick" />
      </MenuBarItem>
    </MenuBar>

    <!-- 未提权提示 -->
    <InfoBar x:Name="ElevationBar"
             Grid.Row="1"
             Margin="16,4,16,4"
             Severity="Warning"
             IsOpen="False"
             IsClosable="False"
             Title="需要管理员权限"
             Message="当前未提权，只能查看，无法执行脱机/联机、分区、格式化等操作。">
      <InfoBar.ActionButton>
        <Button Content="以管理员身份重新启动" Click="OnRestartElevatedClick" />
      </InfoBar.ActionButton>
    </InfoBar>

    <!-- 命令栏 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,0,16,8" Spacing="8">
      <Button x:Name="RefreshButton" Click="OnRefreshClick">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE72C;" FontSize="14" />
          <TextBlock Text="刷新" />
        </StackPanel>
      </Button>
      <TextBlock x:Name="SelectionText"
                 VerticalAlignment="Center"
                 Margin="8,0,0,0"
                 FontSize="12"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Text="未选择卷" />
    </StackPanel>

    <!-- 上：卷列表 -->
    <Border Grid.Row="3"
            Margin="16,0,16,0"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            CornerRadius="6">
      <ListView x:Name="VolumeList"
                SelectionMode="Single"
                SelectionChanged="OnVolumeSelectionChanged"
                Padding="0"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.IsHorizontalRailEnabled="True"
                RightTapped="OnVolumeListRightTapped">
        <ListView.Header>
          <Grid MinWidth="1160" Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="*" MinWidth="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="卷" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="布局" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="类型" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="文件系统" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="状态" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="5" Text="容量" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="6" Text="可用空间" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="7" Text="% 可用" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="8" Text="容错" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="9" Text="开销" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="10" Text="磁盘" FontSize="12" FontWeight="SemiBold" />
          </Grid>
        </ListView.Header>
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid MinWidth="1160" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" MinWidth="90" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding LayoutText}" />
              <TextBlock Grid.Column="2" Text="{Binding TypeName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding FileSystemText}" />
              <TextBlock Grid.Column="4" Text="{Binding StatusText}" />
              <TextBlock Grid.Column="5" Text="{Binding CapacityText}" />
              <TextBlock Grid.Column="6" Text="{Binding FreeSpaceText}" />
              <TextBlock Grid.Column="7" Text="{Binding FreePercentText}" />
              <TextBlock Grid.Column="8" Text="{Binding FaultToleranceText}" />
              <TextBlock Grid.Column="9" Text="{Binding OverheadText}" />
              <TextBlock Grid.Column="10" Text="{Binding DiskText}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

    <!-- 分隔条：拖动可调整上下区域高度 -->
    <Border Grid.Row="4"
            x:Name="Splitter"
            Height="6"
            Margin="16,2,16,2"
            Background="{ThemeResource CardStrokeColorDefaultBrush}"
            CornerRadius="3"
            PointerPressed="OnSplitterPointerPressed"
            PointerMoved="OnSplitterPointerMoved"
            PointerReleased="OnSplitterPointerReleased"
            PointerCaptureLost="OnSplitterPointerReleased" />

    <!-- 下：磁盘图 -->
    <Border Grid.Row="5"
            Margin="16,0,16,0"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            CornerRadius="6">
      <controls:DiskMapView x:Name="DiskMap" />
    </Border>

    <!-- 状态栏 -->
    <Border Grid.Row="6"
            Margin="0,8,0,0"
            Padding="16,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="PermissionText" Grid.Column="1" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
