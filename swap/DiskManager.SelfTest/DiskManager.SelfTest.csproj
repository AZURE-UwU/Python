<Project Sdk="Microsoft.NET.Sdk">

  <!--
    自测工具：在自建的 VHDX 上验证磁盘管理功能。

    安全约束（写死在代码里，见 Program.cs 的 SafetyGuard）：
      1) 只操作"测试前不存在、测试时才挂载上来"的磁盘；
      2) 该磁盘必须是虚拟总线（File Backed Virtual / Virtual）；
      3) 容量必须与自建 VHDX 的设定值一致。
    三条不满足任意一条，程序立即中止，不做任何写操作。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>DiskManager.SelfTest</RootNamespace>
    <AssemblyName>DiskManager.SelfTest</AssemblyName>
  </PropertyGroup>

  <!-- 直接复用主程序的底层与服务层源码，保证测的就是正式代码 -->
  <ItemGroup>
    <Compile Include="..\DiskManager\Interop\*.cs" LinkBase="Linked\Interop" />
    <Compile Include="..\DiskManager\Models\*.cs" LinkBase="Linked\Models" />
    <Compile Include="..\DiskManager\Services\*.cs" LinkBase="Linked\Services" />
    <Compile Include="..\DiskManager\Dialogs\*.cs" LinkBase="Linked\Dialogs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
