<Project Sdk="Microsoft.NET.Sdk">

  <!--
    磁盘脱机小工具 · WPF 版【已冻结】
    ==================================================================
    ⚠ 版本状态：本工程已停止更新，仅保留可用（不再加功能、不再改交互）。
       主线开发在 ../DiskOfflineToolWinUI（WinUI 3 版），两版共用同一份磁盘逻辑。
       保留它的原因：WPF 版没有 Windows App Runtime 依赖，兼容性最好。
    ==================================================================
    版本记录：
      v0.1  2026-09-17  初始版本：列出全部磁盘，对选中磁盘执行脱机 / 联机

    说明：
      1) 默认使用 app.manifest（requireAdministrator），双击即请求管理员权限；
      2) 需要只验证界面时可用：dotnet build -p:NoAdmin=true
      3) 底层互操作与服务层直接链接主程序的源码，保证与主程序走完全相同的已验证逻辑；
         自测模式额外链接了主程序自测工具里的 VHD 辅助类，避免重复实现挂载逻辑。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DiskOfflineTool</AssemblyName>
    <RootNamespace>DiskOfflineTool</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest Condition="'$(NoAdmin)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(NoAdmin)' == 'true'">app.invoker.manifest</ApplicationManifest>
    <Product>磁盘脱机工具</Product>
    <AssemblyTitle>磁盘脱机工具</AssemblyTitle>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Bowen</Company>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 复用主程序已验证的底层代码（只取本工具需要的文件） -->
  <ItemGroup>
    <Compile Include="..\DiskManager\Interop\*.cs" LinkBase="Linked\Interop" />
    <Compile Include="..\DiskManager\Models\*.cs" LinkBase="Linked\Models" />
    <Compile Include="..\DiskManager\Services\DiskInventory.cs" LinkBase="Linked\Services" />
    <Compile Include="..\DiskManager\Services\DiskOperations.cs" LinkBase="Linked\Services" />
    <Compile Include="..\DiskManager\Services\OfflineGuard.cs" LinkBase="Linked\Services" />
    <Compile Include="..\DiskManager\Services\VirtualDiskFileScanner.cs" LinkBase="Linked\Services" />
    <Compile Include="..\DiskManager\Services\VirtualDiskOperations.cs" LinkBase="Linked\Services" />
    <Compile Include="..\DiskManager\Services\FileLockInspector.cs" LinkBase="Linked\Services" />
    <Compile Include="..\DiskManager\Services\OperationLog.cs" LinkBase="Linked\Services" />
    <Compile Include="..\DiskManager\Services\StorageOperations.cs" LinkBase="Linked\Services" />
    <Compile Include="..\DiskManager\Services\PartitionTypeNames.cs" LinkBase="Linked\Services" />
    <Compile Include="..\DiskManager\Services\Elevation.cs" LinkBase="Linked\Services" />
    <Compile Include="..\DiskManager\Services\OperationResult.cs" LinkBase="Linked\Services" />
    <Compile Include="..\DiskManager.SelfTest\VhdHelper.cs" LinkBase="Linked\TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
