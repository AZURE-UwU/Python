<Window x:Class="DiskOfflineTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="磁盘脱机工具（旧版 WPF · 已停止更新）"
        Height="520"
        Width="900"
        MinHeight="360"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
  <DockPanel>

    <Menu DockPanel.Dock="Top" Padding="2">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="刷新(_R)" InputGestureText="F5" Click="OnRefreshClick" />
        <Separator />
        <MenuItem Header="退出(_X)" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="操作(_A)">
        <MenuItem x:Name="OfflineMenuItem" Header="脱机(_O)" Click="OnOfflineClick" />
        <MenuItem x:Name="OnlineMenuItem" Header="联机(_N)" Click="OnOnlineClick" />
        <Separator />
        <MenuItem x:Name="EjectMenuItem" Header="弹出(_E)" Click="OnEjectClick" />
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="关于(_A)" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom" Background="#F5F6F8" BorderBrush="#D5DAE0" BorderThickness="0,1,0,0">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="就绪" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="PermissionText" Text="" />
      </StatusBarItem>
    </StatusBar>

    <Border x:Name="ElevationBanner"
            DockPanel.Dock="Top"
            Background="#FFF4CE"
            BorderBrush="#E0C97F"
            BorderThickness="0,0,0,1"
            Padding="10,6"
            Visibility="Collapsed">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="以管理员身份重新启动" Padding="10,2" Click="OnRestartElevatedClick" />
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="当前未以管理员身份运行，无法读取磁盘或执行脱机/联机操作。" />
      </DockPanel>
    </Border>

    <DockPanel>
      <!-- 工具条 -->
      <Border DockPanel.Dock="Top" Background="#F5F6F8" BorderBrush="#D5DAE0" BorderThickness="0,0,0,1" Padding="8,6">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="RefreshButton" Content="刷新" Width="88" Padding="6,3" Click="OnRefreshClick" />
          <Separator Margin="10,0" />
          <Button x:Name="OfflineButton" Content="脱机" Width="96" Padding="6,3" Margin="0,0,8,0" Click="OnOfflineClick" />
          <Button x:Name="OnlineButton" Content="联机" Width="96" Padding="6,3" Margin="0,0,8,0" Click="OnOnlineClick" />
          <Button x:Name="EjectButton" Content="弹出" Width="96" Padding="6,3" Click="OnEjectClick" ToolTip="安全移除设备（相当于任务栏的「安全删除硬件」），仅对可移动设备有效" />
          <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#444" Text="未选择磁盘" />
        </StackPanel>
      </Border>

      <DataGrid x:Name="DiskGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="None"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                Background="White"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                CanUserReorderColumns="False"
                CanUserSortColumns="False"
                SelectionChanged="OnSelectionChanged"
                MouseDoubleClick="OnGridDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="磁盘" Binding="{Binding NumberText}" Width="80" />
          <DataGridTextColumn Header="设备名称" Binding="{Binding FriendlyName}" Width="260" />
          <DataGridTextColumn Header="总线" Binding="{Binding BusTypeName}" Width="150" />
          <DataGridTextColumn Header="容量" Binding="{Binding CapacityText}" Width="110" />
          <DataGridTextColumn Header="分区" Binding="{Binding Partitions.Count}" Width="70" />
          <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="110" />
          <DataGridTextColumn Header="分区表" Binding="{Binding StyleText}" Width="*" MinWidth="90" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DockPanel>
</Window>
