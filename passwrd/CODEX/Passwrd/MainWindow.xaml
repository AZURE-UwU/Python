<Window
    x:Class="Passwrd.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Passwrd">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        IsTabStop="True"
        KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="HeaderPane"
            Grid.Row="0"
            Padding="24,18,24,16"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="Passwrd" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="在任意应用中通过全局快捷键快速输入文本" />
                </StackPanel>

                <ToggleSwitch
                    x:Name="HotkeysEnabledSwitch"
                    Grid.Column="1"
                    MinWidth="110"
                    Header="全局快捷键"
                    OffContent="已暂停"
                    OnContent="已启用"
                    Toggled="HotkeysEnabledSwitch_Toggled" />
            </Grid>
        </Border>

        <Grid
            x:Name="ListPane"
            Grid.Row="1"
            Margin="24,20,24,24"
            ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="快捷输入" />
                    <Button
                        x:Name="AddButton"
                        Grid.Column="1"
                        Click="AddButton_Click"
                        Content="新增" />
                </Grid>

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ListView
                        x:Name="ShortcutList"
                        Padding="4"
                        SelectionChanged="ShortcutList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,9" ColumnSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding HotkeyDisplay}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <TextBlock
                    Grid.Row="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="快捷键只在设置窗口未获得焦点时输入。"
                    TextWrapping="Wrap" />
            </Grid>

            <Border
                x:Name="EditorPanel"
                Grid.Column="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="编辑快捷输入" />

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                            <TextBox
                                x:Name="NameTextBox"
                                Header="名称"
                                MaxLength="80"
                                PlaceholderText="例如：工作邮箱"
                                TextChanged="EditorField_Changed" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="全局快捷键" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ToggleButton
                                        x:Name="CtrlToggle"
                                        Click="HotkeyModifier_Click"
                                        Content="Ctrl" />
                                    <ToggleButton
                                        x:Name="AltToggle"
                                        Click="HotkeyModifier_Click"
                                        Content="Alt" />
                                    <ToggleButton
                                        x:Name="ShiftToggle"
                                        Click="HotkeyModifier_Click"
                                        Content="Shift" />
                                    <ToggleButton
                                        x:Name="WinToggle"
                                        Click="HotkeyModifier_Click"
                                        Content="Win" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="KeyComboBox"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="KeyComboBox_SelectionChanged" />
                                    <Button
                                        x:Name="CaptureHotkeyButton"
                                        Grid.Column="1"
                                        Click="CaptureHotkeyButton_Click"
                                        Content="直接按键" />
                                </Grid>
                                <TextBlock
                                    x:Name="HotkeyPreviewText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBox
                                x:Name="ContentTextBox"
                                MinHeight="120"
                                AcceptsReturn="True"
                                Header="输入内容"
                                MaxLength="20000"
                                PlaceholderText="按快捷键后，这段文本会输入到当前窗口"
                                TextChanged="EditorField_Changed"
                                TextWrapping="Wrap" />

                            <CheckBox
                                x:Name="AutoEnterCheckBox"
                                Checked="EditorOption_Changed"
                                Content="输入结束后自动按 Enter"
                                Unchecked="EditorOption_Changed" />

                            <ToggleSwitch
                                x:Name="ItemEnabledSwitch"
                                Header="此快捷输入"
                                OffContent="已停用"
                                OnContent="已启用"
                                Toggled="EditorOption_Changed" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="DeleteButton"
                            Click="DeleteButton_Click"
                            Content="删除此条" />
                        <TextBlock
                            x:Name="StatusText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
