<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ADBDevTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ADBDevTool.Models"
    xmlns:controls="using:ADBDevTool.Controls"
    mc:Ignorable="d"
    Title="ADB 无线调试助手">

    <Grid x:Name="RootGrid" Padding="16,12,16,12" RowSpacing="10" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="FilePanelColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="DeviceRow" Height="3*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="LogRow" Height="1*" MinHeight="80" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条：设置按钮固定在最右，用图标；按钮组窄时自动换行 -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" ColumnSpacing="8" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:WrapPanel Grid.Column="0" HorizontalSpacing="8" VerticalSpacing="8">
                <Button x:Name="ScanButton" Content="扫描局域网" MinWidth="110" Click="OnScanClick" />
                <!-- 主体一键配对，右侧箭头展开菜单里放手动添加 -->
                <SplitButton x:Name="PairButton" Content="无线调试配对" MinWidth="130" Click="OnPairClick">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="ManualMenuItem" Text="手动添加设备（IP:端口）" Click="OnManualClick" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button x:Name="RestartAdbButton" Content="重启 adb" MinWidth="100" Click="OnRestartAdbClick" />
                <Button x:Name="ConnectButton" Content="连接" MinWidth="104" Style="{StaticResource AccentButtonStyle}" Click="OnConnectToggleClick" />
            </controls:WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
                <Button x:Name="SettingsButton" FontFamily="Segoe MDL2 Assets" Content="&#xE713;"
                        Padding="10,6" ToolTipService.ToolTip="设置" Click="OnSettingsClick" />
            </StackPanel>
        </Grid>

        <!-- 列表表头 -->
        <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="12" Padding="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="设备（单击选择，双击连接）"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" x:Name="CountText" Text=""
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- 设备列表（选择栏） -->
        <Grid Grid.Row="2" Grid.Column="0">
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                <ListView x:Name="DeviceList"
                          SelectionMode="Single"
                          DoubleTapped="OnDeviceDoubleTapped"
                          SelectionChanged="OnDeviceSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DeviceEntry">
                            <Grid ColumnSpacing="12" Padding="4,6" Opacity="{x:Bind RowOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{x:Bind BadgeBrush}"
                                        CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind StateText}" Foreground="White"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
            <TextBlock x:Name="EmptyHint"
                       Text="还没有发现设备。手机打开「无线调试」后点「扫描局域网」；首次连接需要先点「无线调试配对」。"
                       TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- 手机文件面板：独占右列，纵向与左列（设备列表 + 日志）同高 -->
        <Border x:Name="FilePanel" Grid.Row="1" Grid.RowSpan="5" Grid.Column="2" Visibility="Collapsed"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    AllowDrop="True" DragOver="OnFilePanelDragOver" Drop="OnFilePanelDrop">
                <Grid Padding="10" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="手机文件" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button Grid.Column="1" Content="收起" Padding="10,2" Click="OnHideFilePanelClick" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RemoteUpButton" Content="上一级" Padding="10,2" Click="OnRemoteUpClick" />
                        <TextBox Grid.Column="1" x:Name="RemotePathBox" Text="/sdcard"
                                 FontFamily="Consolas" KeyDown="OnRemotePathKeyDown" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RemoteRefreshButton" Content="刷新" Padding="10,2" Click="OnRemoteRefreshClick" />
                        <Button x:Name="RemoteUploadButton" Grid.Column="1" Content="上传" Padding="10,2" Click="OnRemoteUploadClick" />
                        <Button x:Name="RemoteNewFolderButton" Grid.Column="2" Content="新建文件夹" Padding="10,2" Click="OnRemoteNewFolderClick" />
                        <ProgressBar Grid.Column="3" x:Name="TransferBar" Minimum="0" Maximum="100"
                                     VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <ListView x:Name="RemoteList" SelectionMode="Single"
                                  DoubleTapped="OnRemoteDoubleTapped"
                                  AllowDrop="True" DragOver="OnFilePanelDragOver" Drop="OnFilePanelDrop">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:RemoteEntry">
                                    <Grid ColumnSpacing="8" Padding="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Glyph}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Modified}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="下载到电脑" Click="OnRemoteDownloadClick" />
                                    <MenuFlyoutItem Text="重命名…" Click="OnRemoteRenameClick" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="删除" Click="OnRemoteDeleteClick" />
                                    <MenuFlyoutItem Text="新建文件夹…" Click="OnRemoteNewFolderClick" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>
                    </Border>

                    <TextBlock Grid.Row="4" x:Name="RemoteHint" Text="选中设备后自动列出 /sdcard；文件可直接从资源管理器拖进来上传。"
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

        <!-- 列分隔条：只在手机文件面板展开时有意义 -->
        <controls:SplitterThumb x:Name="ColumnSplitter" Grid.Row="1" Grid.RowSpan="5" Grid.Column="1"
                                Width="6" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Background="Transparent"
                                PointerPressed="OnColumnSplitterPressed"
                                PointerMoved="OnColumnSplitterMoved"
                                PointerReleased="OnColumnSplitterReleased"
                                PointerCaptureLost="OnColumnSplitterReleased">
            <Grid Background="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="3" />
        </controls:SplitterThumb>

        <!-- 行分隔条：拖动改变设备列表与执行日志的高度占比 -->
        <controls:SplitterThumb x:Name="RowSplitter" Grid.Row="3" Grid.Column="0"
                                Height="6" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Background="Transparent"
                                PointerPressed="OnRowSplitterPressed"
                                PointerMoved="OnRowSplitterMoved"
                                PointerReleased="OnRowSplitterReleased"
                                PointerCaptureLost="OnRowSplitterReleased">
            <Grid Background="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="3" />
        </controls:SplitterThumb>

        <!-- 日志表头 + 连接后的操作（按钮组窄时同样自动换行） -->
        <controls:WrapPanel Grid.Row="4" Grid.Column="0" HorizontalSpacing="8" VerticalSpacing="8">
            <TextBlock Text="执行日志" VerticalAlignment="Center" Margin="0,0,8,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="ShellButton" Content="打开 shell" MinWidth="104" Click="OnShellClick" />
            <Button x:Name="CopyButton" Content="复制地址" MinWidth="92" Click="OnCopyClick" />
            <Button x:Name="MirrorButton" Content="投屏" MinWidth="104" Click="OnMirrorToggleClick" />
            <Button x:Name="FilesButton" Content="手机文件" MinWidth="100" Click="OnToggleFilePanelClick" />
            <TextBlock x:Name="FpsText" VerticalAlignment="Center" MinWidth="88" Visibility="Collapsed"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="清空" Click="OnClearLogClick" Padding="10,2" />
        </controls:WrapPanel>

        <TextBox Grid.Row="5" Grid.Column="0" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />

        <!-- 状态栏：状态消息与「已选择」合到一处，横跨整窗宽度，鼠标悬停显示全文 -->
        <Grid Grid.Row="6" Grid.ColumnSpan="3" ColumnSpacing="16" Padding="4,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="正在初始化…"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" x:Name="SelectionText" VerticalAlignment="Center" Text="未选择设备"
                       MaxWidth="460" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
