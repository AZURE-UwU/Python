<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ADBDevTool</RootNamespace>
    <AssemblyName>ADBDevTool</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- 非打包应用也依赖该开关生成 resources.pri 与 XBF 资源，否则运行时报 ms-appx 找不到 MainWindow.xaml。 -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AssemblyTitle>ADB 无线调试助手</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <!-- 随程序分发的 adb 二进制：来源 platform-tools-latest-windows.zip（adb 37.0.1）。 -->
  <ItemGroup>
    <None Include="..\tools\platform-tools\adb.exe" Link="platform-tools\adb.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tools\platform-tools\AdbWinApi.dll" Link="platform-tools\AdbWinApi.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tools\platform-tools\AdbWinUsbApi.dll" Link="platform-tools\AdbWinUsbApi.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tools\platform-tools\libwinpthread-1.dll" Link="platform-tools\libwinpthread-1.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tools\platform-tools\source.properties" Link="platform-tools\source.properties" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tools\platform-tools\NOTICE.txt" Link="platform-tools\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 随程序分发的 scrcpy 3.3.3（Apache-2.0）；不带它自带的 adb，改用上面的 platform-tools。 -->
  <ItemGroup>
    <None Include="..\tools\scrcpy\**\*" Link="scrcpy\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
